{
  "name": "axiz-payment-graph-frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "verify": "ng build --configuration production",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/*.ts\" \"*.json\"",
    "lint": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/*.ts\" \"*.json\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/cli": "22.2.2",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "typescript": "6.0.2",
    "prettier": "3.9.9",
    "@angular/build": "22.2.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "type": "module"
}
