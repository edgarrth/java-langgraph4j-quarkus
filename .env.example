# OPENAI utiliza un modelo y embeddings reales; FIXTURE utiliza respuestas y vectores deterministas exclusivamente para pruebas.
AI_PROVIDER=OPENAI
# Credencial del proveedor OPENAI; cadena secreta no vacía cuando AI_PROVIDER=OPENAI. Se deja vacía con FIXTURE.
OPENAI_API_KEY=
# URL de API de OpenAI; también puede apuntar a una API compatible con chat/completions, herramientas, JSON Schema, SSE y embeddings.
OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo de chat con herramientas, JSON Schema estricto y streaming. Ejemplo: gpt-5-mini; otro ID requiere esas mismas capacidades.
OPENAI_CHAT_MODEL=gpt-5-mini
# Modelo de embeddings compatible con el proveedor. Ejemplos: text-embedding-3-small, text-embedding-3-large.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensión de embeddings del modelo: small admite hasta 1536 y large hasta 3072. FIXTURE usa siempre 1536.
EMBEDDING_DIMENSIONS=1536
# Tiempo máximo por solicitud de modelo en segundos; entero positivo. No se reintenta silenciosamente una generación.
MODEL_TIMEOUT_SECONDS=90
# Puerto HTTP del backend en el host; entero entre 1024 y 65535.
HTTP_PORT=8080
# Puerto de la interfaz en Docker; entero entre 1024 y 65535 distinto de otros puertos.
FRONTEND_PORT=4200
# Credenciales autorizadas por tenant; pares tenant:clave separados por coma. Se cambia cada clave fuera del entorno local.
COPILOT_API_KEYS=tenant-pe-01:local-demo-key,tenant-other:other-demo-key
# Credencial adicional necesaria para revisar informes e ingerir conocimiento; cadena secreta distinta de la clave del operador.
REVIEWER_KEY=local-reviewer-key
# Usuario PostgreSQL; identificador válido. Se utiliza como propietario de la base local y migraciones.
DB_USER=axiz
# Contraseña PostgreSQL; cadena secreta no vacía.
DB_PASSWORD=axiz-local-password
# Puerto PostgreSQL publicado en el host; entero entre 1024 y 65535.
DB_PORT=5432
# URL JDBC para ejecutar el backend en el host. Compose fija su propia URL interna.
JDBC_URL=jdbc:postgresql://localhost:5432/axiz_copilot
# Puerto HTTP de Qdrant en el host; entero entre 1024 y 65535.
QDRANT_PORT=6333
# URL HTTP o HTTPS de Qdrant para el backend en el host. Compose utiliza http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Clave opcional si se conecta un Qdrant externo protegido. Se deja vacía para el Qdrant local del compose.
QDRANT_API_KEY=
# Prefijo de colección, caracteres alfanuméricos y guion bajo. Se añade una huella del modelo y dimensión para separar vectores incompatibles.
QDRANT_COLLECTION=axiz_payment_knowledge_v2
# Máximo de chunks recuperados por turno; entero entre 1 y 20.
RAG_TOP_K=6
# Similitud coseno mínima: número entre 0 y 1. Valores altos exigen coincidencias más cercanas.
RAG_THRESHOLD=0.45
# Tamaño máximo del chunk: entre 100 y 2000 tokens, con conteo del tokenizer de OpenAI.
CHUNK_TOKENS=500
# Solapamiento de tokens: entero desde 0 hasta CHUNK_TOKENS-1.
CHUNK_OVERLAP=60
# Ventana de mensajes anteriores: entero entre 2 y 50. Los resultados de herramientas no se almacenan como memoria permanente.
MEMORY_WINDOW=14
# true ingiere automáticamente el dataset canónico; false permite un arranque sin precarga y exige ingestión posterior.
BOOTSTRAP_ENABLED=true
# URL para ejecutar scripts de pruebas y precarga desde el host; HTTP o HTTPS sin barra final.
BASE_URL=http://localhost:8080
# Tenant y clave de operador utilizados por los scripts; deben coincidir con un par de COPILOT_API_KEYS.
TENANT_ID=tenant-pe-01
API_KEY=local-demo-key
# Puerto del simulador legado, únicamente con el perfil legacy.
SIMULATOR_PORT=8081
# URL del simulador para ejecutar el laboratorio legado en el host; HTTP o HTTPS.
INTEGRATION_URL=http://localhost:8081
# Directorio del laboratorio legado; ruta escribible. El copilot utiliza PostgreSQL para checkpoints.
CHECKPOINT_DIR=.runtime/checkpoints
# Retardo del simulador legado en milisegundos; entero entre 0 y 3000.
SIMULATOR_DELAY_MS=300
