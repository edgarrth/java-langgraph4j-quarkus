# Puerto HTTP del orquestador; entero entre 1024 y 65535.
HTTP_PORT=8080
# Puerto HTTP del simulador; entero entre 1024 y 65535, distinto de HTTP_PORT.
SIMULATOR_PORT=8081
# URL HTTP o HTTPS del simulador para la ejecución en el host.
INTEGRATION_URL=http://localhost:8081
# Directorio local de checkpoints; ruta absoluta o relativa escribible.
CHECKPOINT_DIR=.runtime/checkpoints
# Clave compartida de demostración; cadena no vacía. Se cambia fuera del entorno local.
API_KEY=local-demo-key
# Retardo por operación del simulador, en milisegundos; entero entre 0 y 3000. Se usa 0 para pruebas rápidas.
SIMULATOR_DELAY_MS=300
# Puerto de la interfaz Angular en Docker; entero entre 1024 y 65535 distinto de los otros puertos.
FRONTEND_PORT=4200
# URL del orquestador para precarga y pruebas; URL HTTP o HTTPS sin barra final. En Compose se usa el nombre interno del servicio.
BASE_URL=http://localhost:8080
